{
  "schemaVersion":1,
  "id":"sturdy_trees",
  "version":"${version}",
  "name":"Sturdy Trees",
  "description":"A mod making trees much tougher, with an interesting breaking mechanic.",
  "authors":[
    "ivangeevo"
  ],
  "contact":{
    "repo":"https://github.com/ivangeevo/sturdy-trees"
  },
  "license":"CC-BY-4.0",
  "icon":"assets/sturdy_trees/icon.png",
  "environment":"*",
  "entrypoints":{
    "client":["org.btwr.sturdy_trees.SturdyTreesClient"],
    "main":["org.btwr.sturdy_trees.SturdyTreesMod"],
    "fabric-datagen": ["org.btwr.sturdy_trees.SturdyTreesDataGenerator"],
    "modmenu": ["org.btwr.sturdy_trees.config.SturdyTreesModMenu"]
  },
  "mixins":[
    "sturdy_trees.mixins.json",
    {
      "config": "sturdy_trees.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends":{
    "fabricloader":">=${loader_version}",
    "fabric":"*",
    "minecraft":"${minecraft_version}",
    "btwr_sl": ">=${btwr_sl_version}"
  },
  "accessWidener" : "sturdy_trees.accesswidener"
}